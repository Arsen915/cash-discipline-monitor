# Скопируйте в .env и задайте свои значения.
# Ключ для жюри: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=change-me-to-a-long-random-key

# Порт, на котором nginx отдаёт UI и проксирует API
PUBLIC_PORT=80

# Модель: yolox_tiny.onnx (быстро, по умолчанию) или yolox_s.onnx (точнее, ~3.5x медленнее на CPU)
MODEL_FILE=yolox_tiny.onnx
MAX_CONCURRENT_JOBS=2
ANALYSIS_FPS=3
OBJECT_ZOOM=true
PROCESSING_BUDGET_SEC=55

# Ручная разметка зон камеры и пороги правил (файлы из backend/config/)
# ZONES_FILE=/app/config/zones.json
# RULES_FILE=/app/config/rules.json

# Подставить ключ в UI по умолчанию. ВНИМАНИЕ: ключ окажется в публичном JS — только для демо
# UI_PREFILL_API_KEY=
